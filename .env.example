# Публичные настройки Supabase. Эти значения можно использовать в браузере.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Адрес сайта для ссылок, метаданных и обратных вызовов.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Только для доверенного серверного кода. Никогда не добавляйте NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Онлайн-оплата по умолчанию полностью выключена. Все значения ниже доступны
# только серверному коду и не должны иметь префикс NEXT_PUBLIC_.
PAYMENT_MODE=disabled
PAYMENT_DEFAULT_PROVIDER=mock
PAYMENT_SBP_PROVIDER=mock

# Секрет для подписи тестовых webhook. Используйте случайную строку не короче
# 32 символов и храните её только в переменных окружения.
PAYMENT_MOCK_WEBHOOK_SECRET=your-random-mock-webhook-secret

# Будущая интеграция ЮKassa. Адаптер пока намеренно не выполняет платежи.
YOOKASSA_SHOP_ID=your-yookassa-shop-id
YOOKASSA_SECRET_KEY=your-yookassa-secret-key

# Будущая интеграция интернет-эквайринга Т-Банка.
# Адаптер пока намеренно не выполняет платежи.
TBANK_TERMINAL_KEY=your-tbank-terminal-key
TBANK_PASSWORD=your-tbank-password

# Только для Supabase CLI и миграций. Эти значения не используются в браузере.
# Не публикуйте их и не добавляйте заполненный .env.local в Git.
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=your-personal-access-token
SUPABASE_DB_PASSWORD=your-database-password
